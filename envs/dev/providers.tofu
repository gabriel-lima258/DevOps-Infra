terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    http = {
      source  = "hashicorp/http"
      version = "~> 3.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.0"
    }
  }

  backend "s3" {
    bucket = "algadelivery-tfstate-devops"
    key    = "algadelivery/${var.environment}/remote.tfstate"
    region = var.aws_region
  }
}

provider "aws" {
  region = var.aws_region
}
